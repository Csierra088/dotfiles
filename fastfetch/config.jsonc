{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/ascii.txt",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        },
        "type": "auto",
        "height": 16,
        "width": 28
    },
    "display": {
        "separator": " ",
        "color": {
            "title": "38;2;80;200;255"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "   \u001b[38;2;80;200;255m{user-name} \u001b[38;2;100;100;100m@ \u001b[38;2;120;255;180m{host-name}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;80;200;255m\u256d\u2500  Hardware"
        },
        {
            "type": "host",
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m Host",
            "keyColor": "default"
        },
        {
            "type": "cpu",
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m CPU ",
            "keyColor": "default"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m GPU ",
            "keyColor": "default"
        },
        {
            "type": "disk",
            "dirs": [
                "/"
            ],
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m Disk",
            "keyColor": "default",
            "excludeExternal": true
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;80;200;255m\u2570\u2500 \u001b[38;2;120;255;180m Mem ",
            "keyColor": "default"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;80;200;255m\u256d\u2500  Software"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m OS  ",
            "keyColor": "default"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m Kern",
            "keyColor": "default"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m Pkgs",
            "format": "{all}",
            "keyColor": "default"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;80;200;255m\u2570\u2500 \u001b[38;2;120;255;180m Shell",
            "keyColor": "default"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;80;200;255m\u256d\u2500  Desktop"
        },
        {
            "type": "display",
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m Res ",
            "keyColor": "default"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;80;200;255m\u2570\u2500 \u001b[38;2;120;255;180m Term",
            "keyColor": "default"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;80;200;255m\u256d\u2500  Time"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;80;200;255m\u251c\u2500 \u001b[38;2;120;255;180m Date",
            "keyColor": "default",
            "text": "date '+%a %d %b %Y'"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;80;200;255m\u2570\u2500 \u001b[38;2;120;255;180m Up  ",
            "keyColor": "default"
        },
        "break",
        {
            "type": "colors",
            "symbol": "star",
            "paddingLeft": 0,
            "block": {
                "range": [
                    2,
                    6
                ]
            }
        },
        "break"
    ]
}